datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// GLOBAL ENUMS
// -------------------------------------------------------------

enum DocumentStatus {
  DRAFT
  POSTED
  UNPOSTED
}

enum RoleType {
  ADMIN
  MANAGER
  ACCOUNTANT
  INVENTORY_SUPERVISOR
  SALES_EXECUTIVE
}

enum ModuleType {
  AUTH
  SETUP
  FINANCE
  PARTIES
  HR
  PURCHASE
  INVENTORY
  SALES
  AUDIT
}

enum ActionType {
  CREATE
  EDIT
  DELETE
  POST
  UNPOST
  VIEW
}

enum AccountClassification {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  JV    // Journal Voucher
  BRV   // Bank Receipt Voucher
  BPV   // Bank Payment Voucher
  CRV   // Cash Receipt Voucher
  CPV   // Cash Payment Voucher
}

enum PartyType {
  CLIENT
  SUPPLIER
  AGENT
}

enum CurrencyCode {
  AED
  USD
  PKR
}

enum PackagingUOM {
  BAGS
  BALES
  SACKS
}

enum WeightUOM {
  KG
  LBS
}

// -------------------------------------------------------------
// MODULE 1 & 2: USERS & ACCESS CONTROL
// -------------------------------------------------------------

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String
  passwordHash String
  role         RoleType           @default(ACCOUNTANT)
  isActive     Boolean            @default(true)
  permissions  UserPermission[]
  auditLogs    AuditLog[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("users")
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     ModuleType
  canCreate  Boolean    @default(false)
  canEdit    Boolean    @default(false)
  canDelete  Boolean    @default(false)
  canPost    Boolean    @default(false)
  canUnpost  Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@unique([userId, module])
  @@map("user_permissions")
}

// -------------------------------------------------------------
// MODULE 3: GLOBAL SETUP & CONFIGURATION
// -------------------------------------------------------------

model CompanyProfile {
  id             String       @id @default("default-company")
  companyName    String       @default("Vintage Vibe FZ-LLC")
  addressLine1   String       @default("Plot 42, Industrial Zone 3")
  addressLine2   String       @default("Dubai Wholesale Garments Hub, UAE")
  trnTaxNo       String       @default("TRN-100482910300003")
  defaultCurrency CurrencyCode @default(AED)
  logoUrl        String       @default("/assets/vintage-logo.svg")
  phone          String       @default("+971 4 883 9120")
  email          String       @default("operations@vintagevibe.ae")
  vatRatePercent Decimal      @default(5.0) @db.Decimal(5, 2)
  updatedAt      DateTime     @updatedAt

  @@map("company_profile")
}

model CurrencyMaster {
  id           String       @id @default(uuid())
  code         CurrencyCode @unique
  name         String
  symbol       String
  exchangeRate Decimal      @db.Decimal(10, 4) // relative to base (AED = 1.0)
  isBase       Boolean      @default(false)
  updatedAt    DateTime     @updatedAt

  @@map("currency_master")
}

model ItemMaster {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  category    String         // e.g., "Denim Jackets", "Wool Sweaters", "Silk Shirts"
  description String?
  basePrice   Decimal        @db.Decimal(12, 2)
  targetUom   WeightUOM      @default(KG)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  inventoryPieces InwardGatePassPiece[]
  purchaseItems   PurchaseInvoiceItem[]

  @@map("item_masters")
}

model LabelGrade {
  id          String   @id @default(uuid())
  code        String   @unique // "GRADE_A_CREAM", "GRADE_B", "VINTAGE_SELECTION"
  name        String
  description String?
  sortOrder   Int      @default(0)

  inventoryPieces InwardGatePassPiece[]

  @@map("label_grades")
}

model BrandMaster {
  id          String   @id @default(uuid())
  name        String   @unique // "Levi's", "Carhartt", "Ralph Lauren", "Nike", "Tommy Hilfiger"
  tier        String   @default("Premium Vintage")
  origin      String?

  inventoryPieces InwardGatePassPiece[]

  @@map("brand_masters")
}

model ShopMaster {
  id          String   @id @default(uuid())
  shopNo      String   @unique // "SHOP-01", "WAREHOUSE-WH1"
  name        String
  location    String
  managerName String?
  isActive    Boolean  @default(true)

  inventoryPieces InwardGatePassPiece[]

  @@map("shop_masters")
}

// -------------------------------------------------------------
// MODULE 4: FINANCE & CHART OF ACCOUNTS (COA)
// -------------------------------------------------------------

model COAAccount {
  id             String                @id @default(uuid())
  code           String                @unique // 5-tier: "1000-01-001"
  name           String
  classification AccountClassification
  tierLevel      Int                   @default(3) // 1 to 5
  parentCode     String?
  currency       CurrencyCode          @default(AED)
  currentBalance Decimal               @default(0.0) @db.Decimal(14, 2)
  isSystem       Boolean               @default(false)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())

  debitLines     VoucherLine[]         @relation("DebitAccount")
  creditLines    VoucherLine[]         @relation("CreditAccount")
  ledgerEntries  LedgerEntry[]
  partyLink      PartyAccountMap?

  @@map("coa_accounts")
}

model Voucher {
  id             String         @id @default(uuid())
  voucherNo      String         @unique // "JV-2026-0001", "BRV-2026-0012"
  type           VoucherType
  status         DocumentStatus @default(DRAFT)
  date           DateTime       @default(now())
  narration      String
  totalDebit     Decimal        @db.Decimal(14, 2)
  totalCredit    Decimal        @db.Decimal(14, 2)
  currency       CurrencyCode   @default(AED)
  exchangeRate   Decimal        @default(1.0) @db.Decimal(10, 4)
  postedAt       DateTime?
  postedBy       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines          VoucherLine[]
  ledgerEntries  LedgerEntry[]

  @@map("vouchers")
}

model VoucherLine {
  id           String      @id @default(uuid())
  voucherId    String
  voucher      Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId    String
  account      COAAccount  @relation("DebitAccount", fields: [accountId], references: [id])
  creditAccId  String?
  creditAcc    COAAccount? @relation("CreditAccount", fields: [creditAccId], references: [id])
  debitAmount  Decimal     @default(0.0) @db.Decimal(14, 2)
  creditAmount Decimal     @default(0.0) @db.Decimal(14, 2)
  memo         String?

  @@map("voucher_lines")
}

model LedgerEntry {
  id             String         @id @default(uuid())
  voucherId      String
  voucher        Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId      String
  account        COAAccount     @relation(fields: [accountId], references: [id])
  date           DateTime
  debit          Decimal        @default(0.0) @db.Decimal(14, 2)
  credit         Decimal        @default(0.0) @db.Decimal(14, 2)
  runningBalance Decimal        @db.Decimal(14, 2)
  documentRef    String         // e.g., "PUR-INV-001", "SLS-INV-004", "JV-0001"
  partyId        String?
  party          Party?         @relation(fields: [partyId], references: [id])
  narration      String?
  createdAt      DateTime       @default(now())

  @@map("ledger_entries")
}

// -------------------------------------------------------------
// MODULE 5: PARTIES KHATA (CRM & VENDOR DIRECTORY)
// -------------------------------------------------------------

model Party {
  id             String           @id @default(uuid())
  code           String           @unique // "CLI-001", "SUP-001", "AGT-001"
  name           String
  type           PartyType
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  trnNo          String?
  creditLimit    Decimal          @default(50000.0) @db.Decimal(14, 2)
  currentBalance Decimal          @default(0.0) @db.Decimal(14, 2) // + Receivable, - Payable
  currency       CurrencyCode     @default(AED)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  accountMap     PartyAccountMap?
  purchaseInvoices PurchaseInvoice[]
  salesInvoices  SalesInvoice[]
  salesGatePasses SalesGatePass[]
  ledgerEntries  LedgerEntry[]
  khataLogs      PartyKhataLog[]

  @@map("parties")
}

model PartyAccountMap {
  id               String     @id @default(uuid())
  partyId          String     @unique
  party            Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  receivableAccId  String?    @unique
  receivableAcc    COAAccount? @relation(fields: [receivableAccId], references: [id])
  payableAccId     String?
  clearingAccId    String?
  revenueAccId     String?
  commissionAccId  String?

  @@map("party_account_maps")
}

model PartyKhataLog {
  id          String   @id @default(uuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  docType     String   // "INVOICE", "PAYMENT", "RECEIPT", "CREDIT_NOTE"
  docRef      String
  debit       Decimal  @default(0.0) @db.Decimal(14, 2)
  credit      Decimal  @default(0.0) @db.Decimal(14, 2)
  balance     Decimal  @db.Decimal(14, 2)
  description String

  @@map("party_khata_logs")
}

// -------------------------------------------------------------
// MODULE 6: HR, ATTENDANCE & PAYROLL ENGINE
// -------------------------------------------------------------

model Employee {
  id            String             @id @default(uuid())
  empCode       String             @unique // "EMP-001"
  name          String
  designation   String             // "Sorter", "OCR Scanner", "Accountant", "Bale Handler"
  department    String             @default("Warehouse & Sortery")
  baseSalary    Decimal            @db.Decimal(12, 2)
  housingAllow  Decimal            @default(0.0) @db.Decimal(12, 2)
  transportAllow Decimal           @default(0.0) @db.Decimal(12, 2)
  workingHoursPerDay Int           @default(8)
  isActive      Boolean            @default(true)
  joiningDate   DateTime           @default(now())

  attendance    AttendanceRecord[]
  payrollLogs   PayrollRecord[]

  @@map("employees")
}

model AttendanceRecord {
  id           String         @id @default(uuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthYear    String         // "2026-09"
  daysWorked   Int            @default(30)
  overtimeHours Decimal       @default(0.0) @db.Decimal(6, 2)
  status       DocumentStatus @default(DRAFT)
  lockedAt     DateTime?
  updatedAt    DateTime       @updatedAt

  @@unique([employeeId, monthYear])
  @@map("attendance_records")
}

model PayrollRecord {
  id             String         @id @default(uuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthYear      String         // "2026-09"
  status         DocumentStatus @default(DRAFT)
  baseSalary     Decimal        @db.Decimal(12, 2)
  allowances     Decimal        @db.Decimal(12, 2)
  dailyRate      Decimal        @db.Decimal(10, 2)
  hourlyRate     Decimal        @db.Decimal(10, 2)
  daysWorked     Int
  overtimeHours  Decimal        @db.Decimal(6, 2)
  earnedBasic    Decimal        @db.Decimal(12, 2)
  overtimePay    Decimal        @db.Decimal(12, 2)
  grossPay       Decimal        @db.Decimal(12, 2)
  netPay         Decimal        @db.Decimal(12, 2)
  disbursedDate  DateTime?
  postedAt       DateTime?
  createdAt      DateTime       @default(now())

  @@unique([employeeId, monthYear])
  @@map("payroll_records")
}

// -------------------------------------------------------------
// MODULE 7: USED CLOTHING / BALES PURCHASE & OCR SACK CONVERSION
// -------------------------------------------------------------

model PurchaseInvoice {
  id              String          @id @default(uuid())
  invoiceNo       String          @unique // "PUR-2026-0001"
  supplierId      String
  supplier        Party           @relation(fields: [supplierId], references: [id])
  date            DateTime        @default(now())
  status          DocumentStatus  @default(DRAFT)
  currency        CurrencyCode    @default(AED)
  exchangeRate    Decimal         @default(1.0) @db.Decimal(10, 4)
  subTotal        Decimal         @db.Decimal(14, 2)
  vatAmount       Decimal         @db.Decimal(14, 2)
  totalAmount     Decimal         @db.Decimal(14, 2)
  notes           String?
  convertedToInward Boolean       @default(false)
  inwardGatePassId  String?       @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           PurchaseInvoiceItem[]
  inwardGatePass  InwardGatePass?

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id           String          @id @default(uuid())
  invoiceId    String
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId       String
  item         ItemMaster      @relation(fields: [itemId], references: [id])
  packagingUom PackagingUOM    @default(BALES)
  packageCount Int             @default(1)
  weightUom    WeightUOM       @default(KG)
  totalWeight  Decimal         @db.Decimal(10, 2)
  ratePerWeight Decimal        @db.Decimal(10, 2)
  lineTotal    Decimal         @db.Decimal(14, 2)

  @@map("purchase_invoice_items")
}

model InwardGatePass {
  id                String          @id @default(uuid())
  gatePassNo        String          @unique // "IGP-2026-0001"
  purchaseInvoiceId String          @unique
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  date              DateTime        @default(now())
  status            DocumentStatus  @default(DRAFT)
  totalBaleWeight   Decimal         @db.Decimal(10, 2) // Original purchased bulk weight (e.g., 500.0 KG)
  brokenDownWeight  Decimal         @default(0.0) @db.Decimal(10, 2) // Real-time sum of individual pieces
  remainingWeight   Decimal         @db.Decimal(10, 2) // totalBaleWeight - brokenDownWeight
  pieceCount        Int             @default(0)
  vehicleNo         String?
  containerNo       String?
  receivedBy        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  pieces            InwardGatePassPiece[]

  @@map("inward_gate_passes")
}

model InwardGatePassPiece {
  id               String         @id @default(uuid())
  gatePassId       String
  gatePass         InwardGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  barcode          String         @unique // "VV-2026-09-00123"
  itemId           String
  item             ItemMaster     @relation(fields: [itemId], references: [id])
  brandId          String?
  brand            BrandMaster?   @relation(fields: [brandId], references: [id])
  labelGradeId     String?
  labelGrade       LabelGrade?    @relation(fields: [labelGradeId], references: [id])
  shopId           String?
  shop             ShopMaster?    @relation(fields: [shopId], references: [id])
  
  // OCR & Tag Attributes
  brandScanned     String?
  sizeScanned      String?        // "M", "L", "32x34", "Oversized"
  countryOfOrigin  String?        // "Made in USA", "Japan", "Italy"
  style            String?        // "Vintage 90s Trucker", "Distressed Denim"
  tagImageUrl      String?
  ocrConfidence    Decimal?       @db.Decimal(5, 2)

  weightKg         Decimal        @db.Decimal(8, 3)
  estimatedPrice   Decimal        @db.Decimal(10, 2)
  isSold           Boolean        @default(false)
  soldInvoiceId    String?
  createdAt        DateTime       @default(now())

  salesItems       SalesGatePassItem[]

  @@map("inward_gate_pass_pieces")
}

// -------------------------------------------------------------
// MODULE 8: SALES WORKFLOW (GATE PASS TO INVOICE)
// -------------------------------------------------------------

model SalesGatePass {
  id              String          @id @default(uuid())
  gatePassNo      String          @unique // "SGP-2026-0001"
  customerId      String
  customer        Party           @relation(fields: [customerId], references: [id])
  date            DateTime        @default(now())
  status          DocumentStatus  @default(DRAFT)
  totalPieces     Int             @default(0)
  totalWeight     Decimal         @default(0.0) @db.Decimal(10, 2)
  estimatedAmount Decimal         @default(0.0) @db.Decimal(14, 2)
  isConverted     Boolean         @default(false)
  salesInvoiceId  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           SalesGatePassItem[]
  salesInvoice    SalesInvoice?

  @@map("sales_gate_passes")
}

model SalesGatePassItem {
  id              String              @id @default(uuid())
  salesGatePassId String
  salesGatePass   SalesGatePass       @relation(fields: [salesGatePassId], references: [id], onDelete: Cascade)
  pieceId         String
  piece           InwardGatePassPiece @relation(fields: [pieceId], references: [id])
  barcode         String
  unitPrice       Decimal             @db.Decimal(10, 2)
  discountPercent Decimal             @default(0.0) @db.Decimal(5, 2)
  netPrice        Decimal             @db.Decimal(10, 2)

  @@map("sales_gate_pass_items")
}

model SalesInvoice {
  id               String          @id @default(uuid())
  invoiceNo        String          @unique // "SLS-2026-0001"
  salesGatePassId  String?         @unique
  salesGatePass    SalesGatePass?  @relation(fields: [salesGatePassId], references: [id])
  customerId       String
  customer         Party           @relation(fields: [customerId], references: [id])
  date             DateTime        @default(now())
  status           DocumentStatus  @default(DRAFT)
  currency         CurrencyCode    @default(AED)
  exchangeRate     Decimal         @default(1.0) @db.Decimal(10, 4)
  subTotal         Decimal         @db.Decimal(14, 2)
  discountAmount   Decimal         @default(0.0) @db.Decimal(14, 2)
  vatAmount        Decimal         @db.Decimal(14, 2)
  totalAmount      Decimal         @db.Decimal(14, 2)
  postedAt         DateTime?
  postedBy         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            SalesInvoiceItem[]

  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  barcode        String
  description    String
  weightKg       Decimal      @db.Decimal(8, 3)
  unitPrice      Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0.0) @db.Decimal(10, 2)
  finalAmount    Decimal      @db.Decimal(10, 2)

  @@map("sales_invoice_items")
}

// -------------------------------------------------------------
// MODULE 9: COMPREHENSIVE AUDIT LOG TRAIL
// -------------------------------------------------------------

model AuditLog {
  id          String         @id @default(uuid())
  module      ModuleType
  action      ActionType
  documentRef String         // e.g. "IGP-2026-0001", "PUR-2026-0001", "EMP-001"
  status      DocumentStatus @default(DRAFT)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  userName    String         @default("System Admin")
  timestamp   DateTime       @default(now())
  ipAddress   String?
  details     String         // Human readable change summary
  metaPayload String?        // JSON snapshot of diff or state

  @@index([module, documentRef])
  @@map("audit_logs")
}
