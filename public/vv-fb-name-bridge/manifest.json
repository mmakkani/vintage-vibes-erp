{
  "manifest_version": 3,
  "name": "Vintage Vibes - Facebook Live Real-Name & Reply Bridge",
  "version": "2.9.0",
  "description": "Instant Facebook Live real commenter names + Native GraphQL Host/Murtaza reply bridge.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://vintagevibesgk.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["fb_main_poster.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
